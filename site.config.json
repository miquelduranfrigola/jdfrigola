{
  "_comment": "Global site settings. The paintings come from the Google Sheet + Drive folder (see README). This file controls the look; its header and i18n texts are defaults that the Sheet's settings tab overrides.",

  "_customDomain_help": "Leave empty until the domain is registered AND its DNS points at GitHub Pages. Setting it makes the build emit dist/CNAME, which switches the site to that domain (and redirects the github.io URL to it).",
  "customDomain": "jdfrigola.com",

  "theme": {
    "backgroundColor": "rgb(120, 130, 125)",
    "textColor": "rgb(0, 0, 0)",
    "fontFamily": "'Geist Mono', monospace",
    "fontWeight": 400,
    "fontSize": "12px",
    "lineHeight": "14px",
    "imageBorder": "1px solid rgb(0, 0, 0)",
    "defaultImageWidth": 16,
    "itemSpacing": "5px",
    "siteMargin": "10px",
    "bottomMargin": "200px",
    "sectionSpacing": "90px",
    "sectionHeadGap": "40px",
    "captionImageGap": "10px",
    "mobileBreakpoint": "600px",
    "mobileImageWidth": 70,
    "mobileImageWidthLandscape": 120,
    "badgeColor": "rgb(200, 0, 0)",
    "badgeFontSize": "12px",
    "linkHoverColor": "rgb(200, 0, 0)",
    "hoverSlowFactor": 0.2,
    "hoverEaseMs": 600,
    "dragSettleMs": 350
  },

  "_carousels_help": "Each carousel takes the shown rows of one Sheet `section`; `availableOnly` keeps only rows whose `sold` is not yes. Pieces are ordered by `order`, highest first.",
  "carousels": {
    "AVAILABLE": { "section": "PERSONAL", "availableOnly": true, "direction": "left", "scrollSpeed": 45 },
    "COMPLETE": { "section": "PERSONAL", "direction": "right", "scrollSpeed": 45 },
    "PERSONAL": { "section": "PERSONAL", "direction": "left", "scrollSpeed": 45 },
    "ACADEMICA": { "section": "ACADEMICA", "direction": "right", "scrollSpeed": 45 }
  },

  "_pages_help": "One HTML page per entry, at dist/<path>/index.html. Empty carousels are left out. `noindex` pages are unlisted: never link them, and never add them to a sitemap or robots.txt.",
  "pages": [
    { "path": "", "carousels": ["AVAILABLE", "COMPLETE"], "badge": true },
    { "path": "portfolio", "carousels": ["PERSONAL", "ACADEMICA"], "badge": false, "noindex": true }
  ],

  "images": {
    "maxWidth": 1600,
    "quality": 82
  },

  "header": {
    "name": "JOSEP DURAN FRIGOLA",
    "handle": "@JDFRIGOLA",
    "instagram": "https://www.instagram.com/jdfrigola",
    "email": "jdfrigola@gmail.com",
    "emailSubject": "Hola",
    "copyright": "©2026"
  },

  "i18n": {
    "defaultLang": "ca",
    "languages": [
      { "code": "ca", "label": "CAT" },
      { "code": "es", "label": "ESP" },
      { "code": "en", "label": "ENG" }
    ],
    "sections": {
      "AVAILABLE": {
        "label": { "ca": "OBRA DISPONIBLE", "es": "OBRA DISPONIBLE", "en": "AVAILABLE WORK" },
        "subtitle": { "ca": "", "es": "", "en": "" }
      },
      "COMPLETE": {
        "label": { "ca": "OBRA", "es": "OBRA", "en": "WORK" },
        "subtitle": { "ca": "", "es": "", "en": "" }
      },
      "PERSONAL": {
        "label": { "ca": "OBRA PERSONAL", "es": "OBRA PERSONAL", "en": "PERSONAL WORK" },
        "subtitle": { "ca": "", "es": "", "en": "" }
      },
      "ACADEMICA": {
        "label": { "ca": "OBRA ACADÈMICA", "es": "OBRA ACADÉMICA", "en": "ACADEMIC WORK" },
        "subtitle": {
          "ca": "FETA A LA BARCELONA ACADEMY OF ART ENTRE ELS ANYS 2024 I 2026",
          "es": "REALIZADA EN LA BARCELONA ACADEMY OF ART ENTRE LOS AÑOS 2024 Y 2026",
          "en": "MADE AT THE BARCELONA ACADEMY OF ART BETWEEN 2024 AND 2026"
        }
      }
    },
    "badge": {
      "ca": "ACCEPTO ENCÀRRECS",
      "es": "ACEPTO ENCARGOS",
      "en": "OPEN FOR COMMISSIONS"
    }
  }
}
